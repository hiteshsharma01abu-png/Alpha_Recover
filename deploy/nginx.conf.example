# Nginx (VPS) — static frontend + reverse proxy to the Node API (PM2 on 127.0.0.1:8787).
# TLS via certbot (Let's Encrypt). See docs/DEPLOYMENT.md.

server {
    listen 80;
    server_name alpharecover.com www.alpharecover.com;
    return 301 https://alpharecover.com$request_uri;
}

server {
    listen 443 ssl http2;
    server_name alpharecover.com;

    ssl_certificate     /etc/letsencrypt/live/alpharecover.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/alpharecover.com/privkey.pem;

    root /var/www/alpharecover/current/dist;
    index index.html;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-Frame-Options "DENY" always;

    location ~ /\.(?!well-known) { deny all; }
    location ~ \.map$ { deny all; }

    location /api/ {
        proxy_pass http://127.0.0.1:8787;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;   # TRUSTED_PROXY_HEADER=x-forwarded-for
        proxy_set_header X-Forwarded-Proto $scheme;
        client_max_body_size 1m;
    }

    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    location / {
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }
}
