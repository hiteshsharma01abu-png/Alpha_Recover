# Copy to .env for the API server (`npm run dev:api`). Never commit .env.

NODE_ENV=development
PORT=8787
# Public origin of the site (frontend + API share it). In dev, the Vite server.
APP_URL=http://localhost:5173
LOG_LEVEL=info

# MySQL 8.0+ / MariaDB 10.6+ (docker-compose.yml provides this locally)
DATABASE_URL=mysql://app:app@127.0.0.1:3307/alpharecover
# Used only by the test suite; it is wiped on every run
TEST_DATABASE_URL=mysql://app:app@127.0.0.1:3307/alpharecover_test

# Random secrets, at least 32 characters each: `openssl rand -base64 32`
BETTER_AUTH_SECRET=
CRON_SECRET=
IP_HASH_SALT=

# Header carrying the real client IP behind the host's proxy (e.g. x-forwarded-for). Empty = socket address.
TRUSTED_PROXY_HEADER=

# Optional in development: without a token, emails are logged instead of sent
POSTMARK_SERVER_TOKEN=
EMAIL_FROM="Alpha Recover <info@alpharecover.com>"

# Optional: error tracking
SENTRY_DSN=
